# ─────────────────────────────────────────────────────────────
# RASD | رَصْد — environment template.  Copy to .env and fill in.
# Never commit .env.  No secret is ever read in client code.
# ─────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────
DATABASE_URL="postgresql://rasd:rasd@localhost:5432/rasd"

# ── Session signing (required) ───────────────────────────────
# 32+ random bytes.  Generate with:  openssl rand -base64 48
SESSION_SECRET=""

# ── AI provider (required for agent execution) ───────────────
# Without a key every agent run stops at status=PROVIDER_UNCONFIGURED.
# The platform never fabricates an agent result.
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
AI_MAX_OUTPUT_TOKENS="8000"
AI_REQUEST_TIMEOUT_MS="120000"

# ── Procurement source (optional) ────────────────────────────
# Etimad (اعتماد) has no public self-service API. A commercial
# agreement and credentials are required; see docs/INTEGRATIONS.md.
# Leave empty and the Etimad provider reports NOT_CONFIGURED —
# it never returns invented tenders.
ETIMAD_API_BASE=""
ETIMAD_API_KEY=""

# Demonstration provider: clearly-labelled sample records for local
# development.  Every record it returns carries isDemo = true.
ENABLE_DEMO_PROVIDER="true"

# ── File storage ─────────────────────────────────────────────
# "local" writes under STORAGE_LOCAL_DIR (dev).  "blob" uses a private
# Vercel Blob store (BLOB_READ_WRITE_TOKEN is set when the store is connected
# to the project).  "s3" is a documented seam, not implemented.
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""
STORAGE_LOCAL_DIR="./storage"
MAX_UPLOAD_BYTES="26214400"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# ── Email (optional) ─────────────────────────────────────────
# Unset => verification/reset links are written to the application log
# instead of being sent, and the UI says so.
SMTP_URL=""
MAIL_FROM="RASD <no-reply@rasd.local>"

# ── App ──────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"
LOG_LEVEL="info"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="60"

# ── Serverless (Vercel) ──────────────────────────────────────
# Bearer secret for /api/cron/jobs; Vercel Cron sends it automatically.
# Generate with:  openssl rand -base64 32
CRON_SECRET=""
